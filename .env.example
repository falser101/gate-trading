# Server
APP_ENV=development
APP_PORT=8080
APP_SECRET=your-256-bit-secret-key-here-change-in-prod

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=gate_trading

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Gate.io API (Global default, users can override)
GATE_API_KEY=
GATE_API_SECRET=
GATE_API_BASE_URL=https://api.gateio.ws/api/v4
GATE_WS_URL=wss://api.gateio.ws/ws/v4/

# Copy Trading Sync
COPYTRADING_SYNC_INTERVAL=30
ENCRYPTION_KEY=your-32-byte-encryption-key-here!!
COPYTRADING_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/146.0.0.0 Safari/537.36

# TestNet (for development)
# GATE_API_BASE_URL=https://api-testnet.gateapi.io/api/v4
# GATE_WS_URL=wss://fx-ws-testnet.gateapi.io/ws/v4/
